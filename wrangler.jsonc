{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work-schedule",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "work-schedule-db",
      "database_id": "c663d046-f5f4-4a4c-b295-24d90f3acf07"
    }
  ],
  // 付費方案預設允許 30 秒 CPU，失控迴圈會直接燒錢。正常請求最重的是
  // 登入的 PBKDF2（實測約 74ms），500ms 留足餘裕又能擋住 bug。
  "limits": {
    "cpu_ms": 500
  },
  "observability": {
    "enabled": true
  }
}
