{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work-schedule",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 靜態資產預設優先於 Worker script。不列出這些路徑的話，/ 會直接回
    // index.html，Worker 根本沒機會檢查 session——等於門沒鎖。
    // /login 絕不能列入，否則登入頁自己也要 session，會直接死鎖。
    "run_worker_first": ["/", "/index.html", "/admin", "/admin.html", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "work-schedule-db",
      "database_id": "c663d046-f5f4-4a4c-b295-24d90f3acf07"
    }
  ],
  // 每日備份的去處。R2 免費額度 10GB，而這份備份是幾十 KB 的 JSON——
  // 成本不是考量，「資料只存在一個地方」才是。
  //
  // 儲存桶必須先存在（npx wrangler r2 bucket create work-schedule-backups），
  // 否則 deploy 會失敗——而 --dry-run 不會發現，它不連線。
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "work-schedule-backups"
    }
  ],

  // 付費方案預設允許 30 秒 CPU，失控迴圈會直接燒錢。正常請求最重的是
  // 登入的 PBKDF2（100,000 迭代，約 35ms），500ms 留足餘裕又能擋住 bug。
  "limits": {
    "cpu_ms": 500
  },
  // 每天 00:00 UTC＝台北時間早上 8 點，一次做三件事：寄提醒、備份、清過期資料。
  //
  // 每天只跑一次就夠：提醒的內容一天之內不會變（逾期與否以日期判斷），跑更密
  // 只會增加重複寄信的風險而換不到任何即時性。備份同理——一天一份、留兩週，
  // 足以涵蓋「上週就壞了但今天才發現」。
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
